# Copy to an ignored .env.production on the server. Never commit real values.
APM_DOMAIN=apm.example.com
APM_GATEWAY_BIND=127.0.0.1
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

APM_OTLP_LOGS_ENDPOINT=https://replace-with-private-otlp-endpoint/v1/logs
APM_OTLP_HEADERS_JSON={}

# Every key below must be independently generated. Base64 values decode to at least 32 bytes.
APM_INSTALLATION_HMAC_KEYS_JSON={"v1":"replace-with-base64-32-byte-secret"}
APM_INSTALLATION_HMAC_ACTIVE_KEY_VERSION=v1
APM_QUERY_CURSOR_HMAC_KEY_B64=replace-with-independent-base64-32-byte-secret
APM_WEB_SESSION_HMAC_KEY_B64=replace-with-independent-base64-32-byte-secret
APM_WEB_SESSION_TTL_SECONDS=3600
APM_WEB_SESSION_COOKIE_SECURE=true

APM_SYMBOLIZATION_ENABLED=false
APM_RETRACE_COMMAND_JSON=["/opt/androidapm-tools/retrace"]
APM_RETRACE_TOOL_VERSION=unconfigured
APM_LLVM_SYMBOLIZER_COMMAND_JSON=["/opt/androidapm-tools/llvm-symbolizer"]
APM_LLVM_SYMBOLIZER_TOOL_VERSION=unconfigured
