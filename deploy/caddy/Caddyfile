{$APM_DOMAIN} {
    # Keep process metrics and interactive API docs off the public surface even if the
    # application is accidentally started with a non-production environment label.
    @private_paths path /metrics /metrics/* /docs /docs/* /openapi.json /redoc /redoc/*
    respond @private_paths 404
    encode zstd gzip

    # Apply baseline security headers to every response, including JSON API and health probes.
    # The SPA additionally sets a stricter CSP itself; Caddy must not remove it.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }

    reverse_proxy gateway:8080 {
        # Active checks run on a background timer; they never gate an individual request.
        # There is only one upstream, so a DB-coupled /health/ready probe adds no
        # failover benefit while a single transient DB error (health_fails defaults
        # to 1) can mark the only backend down. Proxy on liveness instead; the deploy
        # process polls /health/ready (which verifies inbox_events) before declaring
        # a rollout successful. Require several consecutive misses as a safeguard.
        health_uri /health/live
        health_interval 15s
        health_timeout 3s
        health_fails 3
    }

    log {
        output stdout
        format json
    }
}
