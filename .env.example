APM_ENVIRONMENT=local
APM_LOG_LEVEL=INFO
APM_DATABASE_URL=postgresql+asyncpg://androidapm:change-me@localhost:5432/androidapm
APM_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
APM_OTLP_HEADERS_JSON={}
APM_INGEST_ENABLED=true
APM_EXPORT_ENABLED=true
APM_INSTALLATION_HMAC_KEYS_JSON={}
APM_INSTALLATION_HMAC_ACTIVE_KEY_VERSION=v1
APM_REMOTE_CONFIG_SIGNING_PRIVATE_KEY_B64=
APM_REMOTE_CONFIG_PUBLIC_KEY_ID=local-development-key
APM_MAX_COMPRESSED_BODY_BYTES=1048576
APM_MAX_DECOMPRESSED_BODY_BYTES=8388608
APM_MAX_BATCH_EVENTS=1000
APM_WORKER_BATCH_SIZE=100
APM_WORKER_LEASE_SECONDS=60
APM_ARTIFACT_STORAGE_PATH=artifacts
APM_MAX_JAVA_MAPPING_BYTES=33554432
APM_MAX_NATIVE_ELF_BYTES=536870912
APM_SYMBOLIZER_BATCH_SIZE=20
APM_SYMBOLIZER_LEASE_SECONDS=120
APM_SYMBOLIZATION_ENABLED=false
APM_RETRACE_COMMAND_JSON=["retrace"]
APM_RETRACE_TOOL_VERSION=unconfigured
APM_LLVM_SYMBOLIZER_COMMAND_JSON=["llvm-symbolizer"]
APM_LLVM_SYMBOLIZER_TOOL_VERSION=unconfigured
APM_QUERY_MAX_WINDOW_DAYS=31
APM_QUERY_MAX_ROWS=10000
APM_QUERY_MAX_LIMIT=100
APM_QUERY_LATE_AFTER_SECONDS=900
APM_QUERY_CURSOR_HMAC_KEY_B64=
APM_WEB_DIST_PATH=web/dist
APM_WEB_SESSION_HMAC_KEY_B64=
APM_WEB_SESSION_TTL_SECONDS=3600
APM_WEB_SESSION_COOKIE_SECURE=false
